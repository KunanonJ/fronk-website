# Site
# Used for canonical URLs, OG metadata, sitemap, RSS feed.
NEXT_PUBLIC_SITE_URL=https://fronk.example.com

# Sanity — required for the blog (/writing) and Studio (/studio) routes.
# Get these from https://www.sanity.io/manage after creating a project.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01
NEXT_PUBLIC_SANITY_STUDIO_URL=

# Server-only Sanity tokens.
# - SANITY_API_READ_TOKEN: optional; needed for draft previews or private datasets.
# - SANITY_REVALIDATE_SECRET: required by /api/revalidate. Generate with `openssl rand -hex 32`.
# - SANITY_PREVIEW_SECRET: required by /api/draft preview links. Generate with `openssl rand -hex 32`.
SANITY_API_READ_TOKEN=
SANITY_REVALIDATE_SECRET=
SANITY_PREVIEW_SECRET=

# Sanity Dashboard / CI schema deploy (sanity.io/manage → API → Tokens → Deploy).
# Required in the deploy/build environment for `pnpm sanity:schema:deploy`.
SANITY_AUTH_TOKEN=

# Newsletter (/writing signup) — server-only, added to a Resend audience.
# - RESEND_API_KEY: from resend.com/api-keys (secret — set in the deploy env only).
# - RESEND_AUDIENCE_ID: resend.com/audiences → your audience → the UUID.
# When either is unset, /api/subscribe returns a friendly "not set up yet"
# message instead of erroring.
RESEND_API_KEY=
RESEND_AUDIENCE_ID=

# Contact form (/contact → /api/contact) — server-only, emails the owner via Resend.
# Reuses RESEND_API_KEY above.
# - CONTACT_TO_EMAIL: inbox that receives messages (e.g. fronk.kunanon@gmail.com).
# - CONTACT_FROM_EMAIL: a sender on a domain verified in Resend,
#   e.g. "KunanonJ <contact@kunanonj.com>". Unverified domains are rejected.
# When any of the three is unset, /api/contact returns a "not connected yet"
# message and the form shows a mailto fallback instead of pretending to send.
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# Cloudflare Web Analytics — optional.
# Copy the token from Cloudflare Web Analytics → Manage site.
NEXT_PUBLIC_CLOUDFLARE_WEB_ANALYTICS_TOKEN=

# Umami analytics — optional.
# - NEXT_PUBLIC_UMAMI_WEBSITE_ID: the UUID from Umami dashboard → Websites → Edit.
#   When set, <Analytics /> in src/routes/__root.tsx loads the tracker
#   in production. Leave blank to disable tracking entirely.
# - NEXT_PUBLIC_UMAMI_HOST: defaults to https://cloud.umami.is for Umami Cloud.
#   Override for self-hosted (e.g. https://analytics.your-domain.com).
# - UMAMI_API_KEY: server-only REST API key. NOT used for tracking; reserved
#   for future server-side stats fetching.
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
NEXT_PUBLIC_UMAMI_HOST=https://cloud.umami.is
UMAMI_API_KEY=

# Google Search Console — optional HTML-tag verification token
# (Search Console → Settings → Ownership verification → HTML tag → content=…).
# Exposed as metadata.verification.google when set.
# Production: set the same value as a Cloudflare Workers var/secret
# `NEXT_PUBLIC_GSC_VERIFICATION`, then redeploy. Required for sea-discovery Phase 7.
NEXT_PUBLIC_GSC_VERIFICATION=

# GitHub — optional. When set, /api/github/contributions prefers GraphQL.
# Without it, the route parses the public contributions HTML for KunanonJ
# and falls back to an honest empty grid only if that fetch fails.
# Create a classic PAT with public `read:user` (or fine-grained read on profile).
GITHUB_TOKEN=
