# Site
# Used for canonical URLs, OG metadata, sitemap, RSS feed.
NEXT_PUBLIC_SITE_URL=https://fronk.example.com

# Sanity — required for the blog (/writing) and Studio (/studio) routes.
# Get these from https://www.sanity.io/manage after creating a project.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01

# Server-only Sanity tokens.
# - SANITY_API_READ_TOKEN: optional; needed for draft previews or private datasets.
# - SANITY_REVALIDATE_SECRET: required by /api/revalidate. Generate with `openssl rand -hex 32`.
# - SANITY_PREVIEW_SECRET: required by /api/draft preview links. Generate with `openssl rand -hex 32`.
SANITY_API_READ_TOKEN=
SANITY_REVALIDATE_SECRET=
SANITY_PREVIEW_SECRET=

# Sanity Dashboard / CI schema deploy (sanity.io/manage → API → Tokens → Deploy).
# Required on Railway for `pnpm sanity:schema:deploy` during build.
SANITY_AUTH_TOKEN=

# Newsletter (/writing signup) — server-only, added to a Resend audience.
# - RESEND_API_KEY: from resend.com/api-keys (secret — set in the deploy env only).
# - RESEND_AUDIENCE_ID: resend.com/audiences → your audience → the UUID.
# When either is unset, /api/subscribe returns a friendly "not set up yet"
# message instead of erroring.
RESEND_API_KEY=
RESEND_AUDIENCE_ID=

# Optional cron endpoint for scheduled publish revalidation (Milestone 5).
# Railway: use on a separate cron service, or set CRON_ENDPOINT_URL explicitly.
#   GET /api/cron/revalidate with `Authorization: Bearer <CRON_SECRET>`.
CRON_SECRET=
# CRON_ENDPOINT_URL=https://your-app.up.railway.app/api/cron/revalidate

# Umami analytics — optional.
# - NEXT_PUBLIC_UMAMI_WEBSITE_ID: the UUID from Umami dashboard → Websites → Edit.
#   When set, <Analytics /> in app/layout.tsx automatically loads the tracker
#   in production. Leave blank to disable tracking entirely.
# - NEXT_PUBLIC_UMAMI_HOST: defaults to https://cloud.umami.is for Umami Cloud.
#   Override for self-hosted (e.g. https://analytics.your-domain.com).
# - UMAMI_API_KEY: server-only REST API key. NOT used for tracking; reserved
#   for future server-side stats fetching.
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
NEXT_PUBLIC_UMAMI_HOST=https://cloud.umami.is
UMAMI_API_KEY=

# Google Analytics 4 — optional.
# The GA4 Measurement ID from Analytics → Admin → Data streams → your web stream
# (looks like G-XXXXXXXXXX). When set, <GoogleAnalytics /> loads gtag.js in
# production only. The ID is public (it ships in the client bundle), so this is
# not a secret — it's an env var purely to stay configurable per environment.
# Must be set in the DEPLOY env: NEXT_PUBLIC_* values are inlined at build time.
NEXT_PUBLIC_GA_ID=
