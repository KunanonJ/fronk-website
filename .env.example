# Site
# Used for canonical URLs, OG metadata, sitemap, RSS feed.
NEXT_PUBLIC_SITE_URL=https://fronk.example.com

# Sanity — required for the blog (/writing) and Studio (/studio) routes.
# Get these from https://www.sanity.io/manage after creating a project.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01

# Server-only Sanity tokens.
# - SANITY_API_READ_TOKEN: optional; needed for draft previews or private datasets.
# - SANITY_REVALIDATE_SECRET: required by /api/revalidate. Generate with `openssl rand -hex 32`.
SANITY_API_READ_TOKEN=
SANITY_REVALIDATE_SECRET=
