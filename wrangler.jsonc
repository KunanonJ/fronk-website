/**
 * Production Worker (kunanonj.com): TanStack Start since the Phase 5 cutover
 * (tanstack-migration). `pnpm build:cloudflare` (vite build) writes
 * .wrangler/deploy/config.json, so a plain `wrangler deploy` ships the built
 * Worker. Staging builds use wrangler.start.jsonc (START_WRANGLER_CONFIG).
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fronk-website",
  "account_id": "187ab61ed9dbc6e616cb23e6b95aa8f1",
  "main": "src/server.ts",
  "compatibility_date": "2026-06-16",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "vars": {
    "NEXT_PUBLIC_SITE_URL": "https://kunanonj.com",
    "NEXT_PUBLIC_SANITY_PROJECT_ID": "nkspfk4b",
    "NEXT_PUBLIC_SANITY_DATASET": "production",
    "NEXT_PUBLIC_SANITY_API_VERSION": "2025-01-01",
    "NEXT_PUBLIC_SANITY_STUDIO_URL": "https://fronk-website.sanity.studio/",
    "NEXT_PUBLIC_UMAMI_HOST": "https://cloud.umami.is",
  },
  // Paths ending in "/" reach the Worker so it can 308 them like Next did.
  "assets": { "run_worker_first": ["/*/"] },
  // Worker cache: Sanity-backed responses carry Cache-Tag and are purged by
  // tag from src/server.ts (Sanity webhook, hourly cron).
  "cache": { "enabled": true },
  "triggers": { "crons": ["0 * * * *"] },
  // Contact and subscribe: 5 posts per minute per IP.
  "ratelimits": [{ "name": "FORM_RATE_LIMIT", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }],
  // OpenNext's two Durable Object classes stay declared (as empty classes
  // exported from src/server.ts) so a dashboard rollback to the Next version
  // still finds them. Remove them, with a deleted_classes migration, once the
  // cutover has held (tanstack-migration Phase 6).
  "durable_objects": {
    "bindings": [
      { "name": "NEXT_CACHE_DO_QUEUE", "class_name": "DOQueueHandler" },
      { "name": "NEXT_TAG_CACHE_DO_SHARDED", "class_name": "DOShardedTagCache" },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["DOQueueHandler", "DOShardedTagCache"],
    },
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
}
