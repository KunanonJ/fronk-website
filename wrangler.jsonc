/**
 * Production Worker (kunanonj.com): TanStack Start since the Phase 5 cutover
 * (tanstack-migration). `pnpm build:cloudflare` (vite build) writes
 * .wrangler/deploy/config.json, so a plain `wrangler deploy` ships the built
 * Worker. Staging builds use wrangler.start.jsonc (START_WRANGLER_CONFIG).
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fronk-website",
  "account_id": "187ab61ed9dbc6e616cb23e6b95aa8f1",
  "main": "src/server.ts",
  "compatibility_date": "2026-06-16",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "vars": {
    "NEXT_PUBLIC_SITE_URL": "https://kunanonj.com",
    "NEXT_PUBLIC_SANITY_PROJECT_ID": "nkspfk4b",
    "NEXT_PUBLIC_SANITY_DATASET": "production",
    "NEXT_PUBLIC_SANITY_API_VERSION": "2025-01-01",
    "NEXT_PUBLIC_SANITY_STUDIO_URL": "https://fronk-website.sanity.studio/",
  },
  // Paths ending in "/" reach the Worker so it can 308 them like Next did.
  // The pages with a Markdown version also run the Worker first, so it can
  // answer Accept: text/markdown (src/server/negotiate.ts); a GET or HEAD
  // that does not prefer Markdown gets the static file through ASSETS, or
  // Start when there is none. Named one by one, not with "/portfolio/*":
  // that would catch the cover images. And not with a "!" pattern: what it
  // matches goes to the static files without the Worker (the build's
  // prerender step got a 404 for /portfolio/<slug>/ instead of its 308).
  // lib/cloudflare/cacheConfig.test.ts keeps the list equal to the projects.
  "assets": {
    "binding": "ASSETS",
    "run_worker_first": [
      "/*/",
      "/",
      "/about",
      "/portfolio/ai-automation",
      "/portfolio/email-signature-generator",
      "/portfolio/kunanonj-com",
      "/portfolio/node-validator-automation",
      "/portfolio/tbh-intranet",
    ],
  },
  // Worker cache: Sanity-backed responses carry Cache-Tag and a one-hour edge
  // lifetime (src/lib/cache.ts); the Sanity webhook purges them by tag from
  // src/server.ts. No cron: the lifetime is the safety net for a missed
  // webhook. The list stays, empty: a deploy leaves the deployed triggers in
  // place when the key is missing.
  "cache": { "enabled": true },
  "triggers": { "crons": [] },
  // Contact and subscribe: 5 posts per minute per IP.
  "ratelimits": [
    {
      "name": "FORM_RATE_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 },
    },
  ],
  // The old Next.js (OpenNext) build's two Durable Object classes: created in
  // v1, deleted in v2 once the TanStack Start cutover had held. Migrations are
  // append-only history; never edit or reuse a tag.
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["DOQueueHandler", "DOShardedTagCache"],
    },
    {
      "tag": "v2",
      "deleted_classes": ["DOQueueHandler", "DOShardedTagCache"],
    },
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
}
