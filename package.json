{
  "name": "fronk-website",
  "version": "0.1.0",
  "private": true,
  "description": "Personal website for Fronk Kunanon Jarat — founder, builder, writer.",
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@10.28.1",
  "pnpm": {
    "overrides": {
      "uuid@<11": "11.1.1",
      "esbuild": "0.28.1",
      "postcss": "8.5.10",
      "vite@>=5.0.0 <6.4.2": "6.4.2"
    }
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start -p ${PORT:-3000}",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "seed": "node scripts/seed-content.mjs",
    "pdf": "node scripts/generate-resume-pdf.mjs",
    "cron:revalidate": "node scripts/cron-revalidate.mjs",
    "setup:railway-cron": "node scripts/setup-railway-cron.mjs",
    "ensure:local-env": "node scripts/ensure-local-env.mjs"
  },
  "dependencies": {
    "@portabletext/react": "^3.2.1",
    "@sanity/client": "^7.4.0",
    "@sanity/code-input": "^7.1.0",
    "@sanity/image-url": "^1.1.0",
    "@sanity/vision": "^4.10.2",
    "lucide-react": "^0.469.0",
    "next": "16.2.6",
    "next-sanity": "^11.6.0",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sanity": "^4.10.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/typography": "^0.5.16",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "jsdom": "^25.0.1",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.0"
  }
}
