{
  "name": "fronk-website",
  "version": "0.3.0",
  "private": true,
  "description": "KunanonJ personal site: TanStack Start on Cloudflare Workers, content from Sanity. Fintech and AI ventures from Bangkok.",
  "engines": {
    "node": ">=26.13.1"
  },
  "packageManager": "pnpm@10.34.9",
  "pnpm": {
    "overrides": {
      "uuid@<11": "11.1.1",
      "esbuild": "0.28.2",
      "postcss": "8.5.33",
      "@babel/core": "7.29.13",
      "dompurify": "3.4.18",
      "form-data": "4.0.6",
      "js-yaml": "4.3.2",
      "smol-toml": "1.9.1",
      "tar": "7.5.23",
      "undici@<7": "6.29.1",
      "undici@7": "7.30.2",
      "ws": "8.23.0",
      "adm-zip": "0.6.1",
      "json-2-csv": "5.6.0",
      "brace-expansion@5": "5.0.13",
      "glob@10": "10.5.0",
      "postcss-selector-parser@6": "6.1.6",
      "minimatch@10": "11.0.9"
    },
    "patchedDependencies": {
      "eslint-plugin-react@7.37.5": "patches/eslint-plugin-react@7.37.5.patch"
    }
  },
  "scripts": {
    "dev": "vite dev",
    "build": "pnpm sanity:manifest && vite build && pnpm sanity:schema:deploy",
    "build:cloudflare": "pnpm build",
    "sanity:manifest": "node scripts/sanity-manifest.mjs",
    "sanity:schema:deploy": "node scripts/sanity-schema-deploy.mjs",
    "studio:dev": "sanity dev",
    "studio:build": "sanity build",
    "studio:deploy": "sanity deploy",
    "start": "vite preview --port ${PORT:-3000} --strictPort",
    "preview": "pnpm build && vite preview",
    "deploy": "pnpm build && wrangler deploy",
    "deploy:staging": "START_WRANGLER_CONFIG=wrangler.start.jsonc pnpm build && wrangler deploy",
    "upload": "pnpm build && wrangler versions upload",
    "lint": "eslint --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "knip": "knip",
    "typecheck:tsc6": "tsc6 --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:update": "playwright test --update-snapshots",
    "perf:budget": "node scripts/check-first-load-budget.mjs",
    "probe": "node scripts/ux-probe.mjs",
    "skills:sync": "node scripts/sync-skills.mjs",
    "oss:sync": "node scripts/sync-open-source.mjs",
    "seed": "node scripts/seed-content.mjs",
    "pdf": "node scripts/generate-resume-pdf.mjs",
    "og:video": "node scripts/og-video.mjs"
  },
  "dependencies": {
    "@cf-wasm/og": "0.5.0",
    "@portabletext/react": "^8.0.1",
    "@sanity/client": "^8.17.0",
    "@sanity/code-input": "^7.3.16",
    "@sanity/image-url": "^2.2.0",
    "@sanity/vision": "^6.24.0",
    "@sanity/webhook": "4.0.4",
    "@tanstack/react-form": "1.33.5",
    "@tanstack/react-query": "5.108.2",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-router-ssr-query": "1.167.3",
    "@tanstack/react-start": "1.169.7",
    "lucide-react": "^1.77.0",
    "next-themes": "^0.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sanity": "^6.24.0",
    "styled-components": "^6.6.0",
    "valibot": "1.5.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@cloudflare/vite-plugin": "1.70.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@tanstack/react-devtools": "0.10.15",
    "@tanstack/react-query-devtools": "5.108.2",
    "@tanstack/react-router-devtools": "1.167.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "5.1.1",
    "eslint": "^10.15.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "jsdom": "^31.0.1",
    "knip": "6.47.0",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-7": "npm:typescript@^7.0.2",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.1",
    "wrangler": "4.166.0"
  }
}
