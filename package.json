{
  "name": "fronk-website",
  "version": "0.2.0",
  "private": true,
  "description": "Personal website for Fronk Kunanon Jarat — founder, builder, writer.",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@10.28.1",
  "pnpm": {
    "overrides": {
      "uuid@<11": "11.1.1",
      "esbuild": "0.28.1",
      "postcss": "8.5.10",
      "@babel/core": "7.29.6",
      "dompurify": "3.4.11",
      "form-data": "4.0.6",
      "js-yaml": "4.2.0",
      "smol-toml": "1.6.1",
      "tar": "7.5.16",
      "undici@<7": "6.27.0",
      "undici@>=7": "7.28.0",
      "ws": "8.21.0"
    },
    "patchedDependencies": {
      "eslint-plugin-react@7.37.5": "patches/eslint-plugin-react@7.37.5.patch"
    }
  },
  "scripts": {
    "dev": "next dev",
    "build": "pnpm sanity:manifest && next build && pnpm sanity:schema:deploy",
    "build:cloudflare": "pnpm sanity:manifest && pnpm exec opennextjs-cloudflare build && pnpm sanity:schema:deploy",
    "sanity:manifest": "sanity manifest extract --path public/studio/static",
    "sanity:schema:deploy": "node scripts/sanity-schema-deploy.mjs",
    "studio:dev": "sanity dev",
    "studio:build": "sanity build",
    "studio:deploy": "sanity deploy",
    "start": "next start -p ${PORT:-3000}",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "cron:preview": "wrangler dev --config wrangler.revalidate-cron.jsonc --env local --test-scheduled --port 8789",
    "cron:deploy": "wrangler deploy --config wrangler.revalidate-cron.jsonc --env=\"\"",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:update": "playwright test --update-snapshots",
    "analyze": "ANALYZE=true next build --webpack",
    "perf:budget": "node scripts/check-first-load-budget.mjs",
    "seed": "node scripts/seed-content.mjs",
    "pdf": "node scripts/generate-resume-pdf.mjs",
    "cron:revalidate": "node scripts/cron-revalidate.mjs",
    "ensure:local-env": "node scripts/ensure-local-env.mjs"
  },
  "dependencies": {
    "@portabletext/react": "^6.2.0",
    "@sanity/client": "^7.23.0",
    "@sanity/code-input": "^7.1.6",
    "@sanity/image-url": "^2.1.1",
    "@sanity/vision": "^6.2.0",
    "framer-motion": "^12.42.2",
    "gsap": "^3.15.0",
    "lenis": "^1.3.25",
    "lucide-react": "^1.21.0",
    "next": "16.2.9",
    "next-sanity": "^13.1.1",
    "next-themes": "^0.4.6",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "sanity": "^6.2.0",
    "styled-components": "^6.4.2",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@next/bundle-analyzer": "^16.2.9",
    "@opennextjs/cloudflare": "1.19.11",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.3.1",
    "@tailwindcss/typography": "^0.5.20",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19",
    "@types/three": "^0.184.1",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^10.5.0",
    "eslint-config-next": "16.2.9",
    "jsdom": "^29.1.1",
    "prettier": "^3.8.4",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tailwindcss": "^4.3.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9",
    "wrangler": "4.104.0"
  }
}
