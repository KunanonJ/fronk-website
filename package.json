{
  "name": "fronk-website",
  "version": "0.3.0",
  "private": true,
  "description": "KunanonJ personal site — cinematic landing + showcase on Next.js / Cloudflare Workers. Fintech & AI ventures from Bangkok.",
  "engines": {
    "node": ">=22.22.2"
  },
  "packageManager": "pnpm@10.34.9",
  "pnpm": {
    "overrides": {
      "uuid@<11": "11.1.1",
      "esbuild": "0.28.1",
      "postcss": "8.5.32",
      "@babel/core": "7.29.7",
      "dompurify": "3.4.17",
      "form-data": "4.0.6",
      "js-yaml": "4.3.2",
      "smol-toml": "1.9.1",
      "tar": "7.5.22",
      "undici@<7": "6.29.1",
      "undici@>=7": "7.30.1",
      "ws": "8.21.0",
      "adm-zip": "0.6.1",
      "json-2-csv": "5.5.11",
      "brace-expansion@5": "5.0.12",
      "glob@10": "10.5.0",
      "postcss-selector-parser@6": "6.1.5"
    },
    "patchedDependencies": {
      "eslint-plugin-react@7.37.5": "patches/eslint-plugin-react@7.37.5.patch"
    }
  },
  "scripts": {
    "dev": "vite dev",
    "build": "pnpm sanity:manifest && vite build && pnpm sanity:schema:deploy",
    "build:cloudflare": "pnpm build",
    "sanity:manifest": "node scripts/sanity-manifest.mjs",
    "sanity:schema:deploy": "node scripts/sanity-schema-deploy.mjs",
    "studio:dev": "sanity dev",
    "studio:build": "sanity build",
    "studio:deploy": "sanity deploy",
    "start": "vite preview --port ${PORT:-3000} --strictPort",
    "preview": "pnpm build && vite preview",
    "deploy": "pnpm build && wrangler deploy",
    "deploy:staging": "START_WRANGLER_CONFIG=wrangler.start.jsonc pnpm build && wrangler deploy",
    "upload": "pnpm build && wrangler versions upload",
    "cron:preview": "wrangler dev --config wrangler.revalidate-cron.jsonc --env local --test-scheduled --port 8789",
    "cron:deploy": "wrangler deploy --config wrangler.revalidate-cron.jsonc --env=\"\"",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "typecheck:tsc6": "tsc6 --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:update": "playwright test --update-snapshots",
    "perf:budget": "node scripts/check-first-load-budget.mjs",
    "probe": "node scripts/ux-probe.mjs",
    "skills:sync": "node scripts/sync-skills.mjs",
    "seed": "node scripts/seed-content.mjs",
    "pdf": "node scripts/generate-resume-pdf.mjs",
    "cron:revalidate": "node scripts/cron-revalidate.mjs",
    "ensure:local-env": "node scripts/ensure-local-env.mjs"
  },
  "dependencies": {
    "@cf-wasm/og": "0.5.0",
    "@portabletext/react": "^8.0.1",
    "@sanity/client": "^8.14.1",
    "@sanity/code-input": "^7.3.14",
    "@sanity/image-url": "^2.1.1",
    "@sanity/vision": "^6.21.0",
    "@sanity/webhook": "4.0.4",
    "@tanstack/react-form": "1.33.5",
    "@tanstack/react-query": "5.107.1",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-router-ssr-query": "1.167.3",
    "@tanstack/react-start": "1.169.5",
    "lucide-react": "^1.66.0",
    "next-themes": "^0.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sanity": "^6.21.0",
    "simple-icons": "^16.36.0",
    "styled-components": "^6.6.0",
    "valibot": "1.5.0",
    "web-vitals": "6.2.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@cloudflare/vite-plugin": "1.67.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/react-devtools": "0.10.14",
    "@tanstack/react-query-devtools": "5.107.1",
    "@tanstack/react-router-devtools": "1.167.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "^10.14.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-7": "npm:typescript@^7.0.2",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.6",
    "vitest": "^5.0.5",
    "wrangler": "4.156.1"
  }
}
