{
  "name": "fronk-website",
  "version": "0.3.0",
  "private": true,
  "description": "KunanonJ personal site — cinematic landing + showcase on Next.js / Cloudflare Workers. Fintech & AI ventures from Bangkok.",
  "engines": {
    "node": ">=22.22.2"
  },
  "packageManager": "pnpm@10.34.9",
  "pnpm": {
    "overrides": {
      "uuid@<11": "11.1.1",
      "esbuild": "0.28.1",
      "postcss": "8.5.32",
      "@babel/core": "7.29.7",
      "dompurify": "3.4.17",
      "form-data": "4.0.6",
      "js-yaml": "4.3.2",
      "smol-toml": "1.9.1",
      "tar": "7.5.22",
      "undici@<7": "6.29.1",
      "undici@>=7": "7.30.1",
      "ws": "8.21.0",
      "adm-zip": "0.6.1",
      "json-2-csv": "5.5.11",
      "brace-expansion@5": "5.0.12",
      "glob@10": "10.5.0",
      "postcss-selector-parser@6": "6.1.5"
    },
    "patchedDependencies": {
      "eslint-plugin-react@7.37.5": "patches/eslint-plugin-react@7.37.5.patch"
    }
  },
  "scripts": {
    "dev": "next dev",
    "build": "pnpm sanity:manifest && next build && pnpm sanity:schema:deploy",
    "build:cloudflare": "opennextjs-cloudflare build",
    "sanity:manifest": "node scripts/sanity-manifest.mjs",
    "sanity:schema:deploy": "node scripts/sanity-schema-deploy.mjs",
    "studio:dev": "sanity dev",
    "studio:build": "sanity build",
    "studio:deploy": "sanity deploy",
    "start": "next start -p ${PORT:-3000}",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "cron:preview": "wrangler dev --config wrangler.revalidate-cron.jsonc --env local --test-scheduled --port 8789",
    "cron:deploy": "wrangler deploy --config wrangler.revalidate-cron.jsonc --env=\"\"",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "typecheck:tsc6": "tsc6 --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:update": "playwright test --update-snapshots",
    "analyze": "ANALYZE=true next build --webpack",
    "perf:budget": "node scripts/check-first-load-budget.mjs",
    "probe": "node scripts/ux-probe.mjs",
    "skills:sync": "node scripts/sync-skills.mjs",
    "seed": "node scripts/seed-content.mjs",
    "pdf": "node scripts/generate-resume-pdf.mjs",
    "cron:revalidate": "node scripts/cron-revalidate.mjs",
    "ensure:local-env": "node scripts/ensure-local-env.mjs"
  },
  "dependencies": {
    "@portabletext/react": "^8.0.1",
    "@sanity/client": "^8.14.1",
    "@sanity/code-input": "^7.3.14",
    "@sanity/image-url": "^2.1.1",
    "@sanity/vision": "^6.21.0",
    "lucide-react": "^1.66.0",
    "next": "16.4.3",
    "next-sanity": "^13.4.0",
    "next-themes": "^0.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sanity": "^6.21.0",
    "simple-icons": "^16.36.0",
    "styled-components": "^6.6.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@next/bundle-analyzer": "^16.4.3",
    "@opennextjs/cloudflare": "1.20.15",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^10.14.0",
    "eslint-config-next": "16.4.3",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-7": "npm:typescript@^7.0.2",
    "vitest": "^5.0.5",
    "wrangler": "4.156.1"
  }
}
