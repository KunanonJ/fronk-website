{
  "name": "fronk-website",
  "version": "0.3.0",
  "private": true,
  "description": "KunanonJ personal site — cinematic landing + showcase on Next.js / Cloudflare Workers. Fintech & AI ventures from Bangkok.",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@10.28.1",
  "pnpm": {
    "overrides": {
      "uuid@<11": "11.1.1",
      "esbuild": "0.28.1",
      "postcss": "8.5.10",
      "@babel/core": "7.29.7",
      "dompurify": "3.4.11",
      "form-data": "4.0.6",
      "js-yaml": "4.2.0",
      "smol-toml": "1.6.1",
      "tar": "7.5.16",
      "undici@<7": "6.27.0",
      "undici@>=7": "7.28.0",
      "ws": "8.21.0",
      "adm-zip": "0.6.0",
      "json-2-csv": "5.5.11",
      "brace-expansion@5": "5.0.7"
    },
    "patchedDependencies": {
      "eslint-plugin-react@7.37.5": "patches/eslint-plugin-react@7.37.5.patch"
    }
  },
  "scripts": {
    "dev": "next dev",
    "build": "pnpm sanity:manifest && next build && pnpm sanity:schema:deploy",
    "build:cloudflare": "pnpm sanity:manifest && pnpm exec opennextjs-cloudflare build && pnpm sanity:schema:deploy",
    "sanity:manifest": "sanity manifest extract --path public/studio/static",
    "sanity:schema:deploy": "node scripts/sanity-schema-deploy.mjs",
    "studio:dev": "sanity dev",
    "studio:build": "sanity build",
    "studio:deploy": "sanity deploy",
    "start": "next start -p ${PORT:-3000}",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "cron:preview": "wrangler dev --config wrangler.revalidate-cron.jsonc --env local --test-scheduled --port 8789",
    "cron:deploy": "wrangler deploy --config wrangler.revalidate-cron.jsonc --env=\"\"",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "typecheck:tsc6": "tsc6 --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:update": "playwright test --update-snapshots",
    "analyze": "ANALYZE=true next build --webpack",
    "perf:budget": "node scripts/check-first-load-budget.mjs",
    "seed": "node scripts/seed-content.mjs",
    "pdf": "node scripts/generate-resume-pdf.mjs",
    "cron:revalidate": "node scripts/cron-revalidate.mjs",
    "ensure:local-env": "node scripts/ensure-local-env.mjs"
  },
  "dependencies": {
    "@portabletext/react": "^8.0.1",
    "@sanity/client": "^8.6.1",
    "@sanity/code-input": "^7.3.8",
    "@sanity/image-url": "^2.1.1",
    "@sanity/vision": "^6.13.2",
    "framer-motion": "^13.3.0",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "lucide-react": "^1.46.0",
    "next": "16.3.5",
    "next-sanity": "^13.3.4",
    "next-themes": "^0.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sanity": "^6.13.2",
    "simple-icons": "^16.31.0",
    "styled-components": "^6.5.3",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@next/bundle-analyzer": "^16.3.5",
    "@opennextjs/cloudflare": "1.20.6",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-config-next": "16.3.5",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-7": "npm:typescript@^7.0.2",
    "vitest": "^5.0.1",
    "wrangler": "4.131.2"
  }
}
