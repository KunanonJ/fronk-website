/**
 * Staging Worker (fronk-website-start, tanstack-migration). Same app as
 * production (wrangler.jsonc) without the legacy Durable Objects. Build and
 * deploy with `pnpm deploy:staging`.
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fronk-website-start",
  "account_id": "187ab61ed9dbc6e616cb23e6b95aa8f1",
  "main": "src/server.ts",
  "compatibility_date": "2026-06-16",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "vars": {
    "NEXT_PUBLIC_SITE_URL": "https://kunanonj.com",
    "NEXT_PUBLIC_SANITY_PROJECT_ID": "nkspfk4b",
    "NEXT_PUBLIC_SANITY_DATASET": "production",
    "NEXT_PUBLIC_SANITY_API_VERSION": "2025-01-01",
    "NEXT_PUBLIC_SANITY_STUDIO_URL": "https://fronk-website.sanity.studio/",
  },
  // Paths ending in "/" reach the Worker so it can 308 them like Next;
  // otherwise the asset handler answers /about/ itself with a 307.
  "assets": { "run_worker_first": ["/*/"] },
  // Contact and subscribe: 5 posts per minute per IP (approximate, per data
  // centre). TURNSTILE_SECRET_KEY is a secret (wrangler secret put).
  "ratelimits": [
    {
      "name": "FORM_RATE_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 },
    },
  ],
  // Worker cache in front of the Worker: Sanity-backed responses carry
  // Cache-Tag + CDN-Cache-Control (one hour) and are purged by tag from
  // src/server.ts (webhook). Replaces OpenNext's R2 cache and Durable Objects.
  // No cron; the list stays, empty, so that a deploy removes the old one.
  "cache": { "enabled": true },
  "triggers": { "crons": [] },
  "observability": { "enabled": true },
}
